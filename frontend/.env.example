# Copy to frontend/.env and adjust. Only variables prefixed with VITE_ reach the browser,
# so never put secrets in this file.

# Base URL of the CampusX API (must include the /api/v1 version prefix).
VITE_API_URL=http://localhost:5000/api/v1

# Optional. Live updates (Socket.IO) address. Defaults to the origin of VITE_API_URL.
# VITE_SOCKET_URL=http://localhost:5000
