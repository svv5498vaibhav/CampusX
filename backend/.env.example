# Copy to backend/.env and fill in values. Never commit the real .env file.

PORT=5000
NODE_ENV=development

# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/campusx_dev for a local server,
# or mongodb+srv://<user>:<password>@<cluster-host>/campusx for MongoDB Atlas.
# Required in production. In development the API starts without it and logs a warning.
MONGODB_URI=

# Optional. DNS servers Node.js uses to look up mongodb+srv:// (Atlas) addresses, comma-separated,
# e.g. 8.8.8.8,1.1.1.1. Leave empty to use the system DNS. Some Windows setups leave Node.js with
# no usable DNS server (error "querySrv ECONNREFUSED"); the API then falls back to public DNS
# automatically, or to these servers when set (e.g. your college network's DNS).
DNS_SERVERS=

# Frontend origin(s) allowed by CORS and Socket.IO. Comma-separate multiple origins.
# Exact origins only (scheme + host + port, no path or trailing slash); "*" is refused.
# Production requires https origins (localhost excepted).
CLIENT_URL=http://localhost:5173

# Signs access tokens. Required in production (32+ characters; example/placeholder values such as
# "replace_with_secure_secret" are refused). If empty in development, a temporary secret is generated
# on each start; production never generates one. Generate a real secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access token lifetime (short; the frontend renews it silently using the refresh cookie).
# At most 1h in production.
JWT_EXPIRES_IN=15m
# How long a device stays signed in without activity (refresh token / session lifetime).
REFRESH_TOKEN_EXPIRES_IN=7d

# Brute-force protection: failed passwords before sign-in is locked, and for how long. The same lock
# applies to email addresses without an account, so a locked answer never reveals who is registered.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Optional. SameSite policy for the refresh cookie: lax (default in development) or none
# (default in production, needed when the frontend and API are on different sites).
COOKIE_SAME_SITE=

# Optional. When empty or unreachable, the API continues with an in-memory cache and in-memory
# rate-limit counters (per API process). Use a password-protected URL (rediss:// for TLS) in production.
REDIS_URL=

# Cloudinary credentials for profile photos, cover images and post media.
# Optional during development; without them media uploads are unavailable.
# The API key must be allowed to upload and delete assets (Cloudinary Console > Settings > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Requests per 15 minutes per IP across the API (default 1000). Keep it generous:
# students on a college network often share one public IP. Login/sign-up have stricter limits.
RATE_LIMIT_MAX=1000

# Optional. Number of reverse proxies in front of the API (e.g. 1 on Render/Railway/Nginx)
# so rate limiting sees the real client IP. Leave 0 for local development.
TRUST_PROXY=0
